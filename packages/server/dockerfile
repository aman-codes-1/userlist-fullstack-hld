ARG SERVICE
ARG PORT
ARG PORT_2

FROM node:18-alpine AS builder
WORKDIR /usr/src/app

# Copy root-level files
COPY package*.json tsconfig*.json ./
RUN npm install

# Copy project source (apps + shared libs)
COPY apps ./apps
COPY libs ./libs

# Build all apps
RUN npm run build

# ───── Runtime image ─────
FROM node:18-alpine
WORKDIR /usr/src/app
ENV NODE_ENV=production
ENV PORT=${PORT}
ENV PORT_2=${PORT_2}
ENV SERVICE=${SERVICE}

COPY --from=builder /usr/src/app/dist ./dist
COPY package*.json ./
RUN npm install --only=production

EXPOSE ${PORT}
EXPOSE ${PORT_2}

# FIXED: shell-based CMD to resolve $SERVICE at runtime
CMD sh -c "node dist/apps/$SERVICE/src/main.js"
